# Server Configuration
PORT=5000
NODE_ENV=development

# Security Secrets (Must be long random strings)
JWT_SECRET=your_jwt_secret_key_here
SESSION_SECRET=your_session_secret_key_here
ENCRYPTION_SECRET=your_32_character_hex_encryption_secret_here

# Database Config
MONGODB_URI=mongodb://localhost:27017/notokenlimit

# AI Provider Configuration
# Standard NVIDIA API Base URL (compatible with OpenAI client structure)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
DEFAULT_MODEL=meta/llama-3.1-70b-instruct

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Discord OAuth configuration (Optional for local credentials auth, required for Discord login)
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:5000/api/auth/discord/callback
